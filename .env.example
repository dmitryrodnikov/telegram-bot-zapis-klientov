# Токен из @BotFather. Это пароль от бота: не публикуйте его и не коммитьте.
BOT_TOKEN=

# Telegram id администраторов через запятую.
# Пока поле пустое, бот покажет ваш id в ответ на /start.
ADMIN_IDS=

# Публичный https-адрес этого же процесса. Пусто — работают только кнопки в чате.
# Пример: https://booking.example.com
WEBAPP_URL=

HOST=127.0.0.1
PORT=8080

# 1 — мини-приложение можно открыть в браузере без Telegram.
# Поставьте 0, прежде чем давать адрес мини-приложения другим людям.
ALLOW_DEMO=1
